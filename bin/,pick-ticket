#!/bin/bash
set -euo pipefail
pick_ticket() {
    gh issue list --assignee "@me" --state OPEN |
    awk -F'\t' '{
        date=$5
        number=$1
        title=$3
        print date "\t" number "\t" title
    }' |
    fzf --delimiter '\t' --nth=3
}
pick_type() {
    cat <<EOF | fzf
feat
fix
chore
refactor
EOF
}
render_name() {
    local kind="$1" name="$2"
    printf "%s/%s" \
    "$kind" \
    "$(
      echo "$name" |
      awk -F'\t' '{
        t = tolower($3)
        gsub(/[^a-z0-9]+/, "-", t)
        gsub(/^-|-$/, "", t)
        print $2 "/" t
      }'
    )"
}

main() {
    local ticket="" kind="" name=""
    ticket="$(pick_ticket)"
    kind="$(pick_type)"
    name="$(render_name "$kind" "$ticket")"
    git bb "$name"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
