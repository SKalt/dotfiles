#!/bin/bash
### USAGE: ,review BRANCH
# TODO: handle github stacks
set -euo pipefail -o errtrace
traperr() {
  echo "ERROR: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}"
}
set -o errtrace
trap traperr ERR
review_branch="${1:?missing BRANCH}"
main_branch="${MAIN_BRANCH:-}"
if [ -z "$main_branch" ]; then
    main_branch="$(~/bin/git-main-branch)"
fi
# check if this is in a git worktree with the expected structure
dirs=()
for d in $(
  git worktree list | cut -d' ' -f1 | awk '
    /\/main\/?$/   { main=$1   }
    /\/review\/?$/ { review=$1 }
    END {
        print main " " review
    }
  '
); do
  dirs+=("$d")
done

main_dir="${dirs[0]}"
review_dir="${dirs[1]}"
if [ "$review_branch" = HEAD ]; then
    review_branch="$(git rev-parse --abbrev-ref HEAD)"
    review_dir=$PWD
fi

cd "$main_dir"
git stash --include-untracked
git switch "$main_branch"
git pull

cd "$review_dir"
git stash --include-untracked
git switch "$review_branch"
e -n . # this *should* be backgrounded
flags=()
case "${EDITOR:-vi}" in
    zed|*/zed*) flags+=(-e);;
    code|*/code*) flags+=(-r) ;;
    *) echo "unsupported review editor: ${EDITOR:-vi}" && exit 127 ;;
esac
git diff --name-only "${main_branch}...${review_branch}" | while read -r d; do
  pre="$main_dir/$d"
  post="$review_dir/$d"
  if [ ! -f "$review_dir/$d" ]; then
    # TODO: maybe use /tmp/ instead of $review_dir
    post="$review_dir/.deleted"
    printf "" > "$post"
  fi
  if [ ! -f "$pre" ]; then
    e "${flags[@]}" "$post"
  else
    e "${flags[@]}" --diff "$pre" "$post"
  fi
done
